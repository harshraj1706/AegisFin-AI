# ==============================================================================
# AegisFin-AI — Comprehensive .gitignore
# ==============================================================================

# Python Bytecode and Compilation Cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Test & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
.streamlit/secrets.toml

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# System & OS Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.directory

# IDE & Editor Settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Application Logs, PIDs, & Temporary Files
*.log
*.pid
scratch/
temp/
tmp/

# Databases & Backups
*.sqlite
*.sqlite3
*.db
*.bak
